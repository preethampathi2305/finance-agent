# Plaid (https://dashboard.plaid.com/developers/keys)
PLAID_CLIENT_ID=
# Use the Sandbox secret for sandbox, Production secret for live banks.
# Note: Plaid's separate "Development" environment is deprecated.
PLAID_SECRET=
# sandbox | production  (development only if your dashboard still shows it)
PLAID_ENV=sandbox

# For Chase, Amex, Capital One, etc. Must also be allowlisted in
# Plaid Dashboard → Team → API → Allowed redirect URIs.
# Production requires https (use ngrok), e.g.:
# PLAID_REDIRECT_URI=https://YOUR_SUBDOMAIN.ngrok-free.app/oauth
# Sandbox may use: http://localhost:4545/oauth
PLAID_REDIRECT_URI=

# 32+ character secret used to encrypt stored Plaid access tokens
ENCRYPTION_KEY=change-me-to-a-long-random-string

# Optional override. Default: ./data/finance.sandbox.db or finance.live.db
# DATABASE_PATH=./data/finance.live.db

# One-time Plaid Link connect UI
CONNECT_PORT=4545
